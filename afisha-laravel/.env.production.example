APP_NAME=АфишаКолыма
APP_ENV=production
APP_KEY=             # php artisan key:generate
APP_DEBUG=false
APP_URL=https://afishakolyma.ru

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=afisha
DB_USERNAME=afisha_user
DB_PASSWORD=STRONG_PASSWORD_HERE

SESSION_DRIVER=file
CACHE_STORE=redis       # или file если Redis недоступен
QUEUE_CONNECTION=sync

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

FILESYSTEM_DISK=public_frontend
